# ==============================================================
#  주식 자동매매 봇 환경변수 설정
#  이 파일을 복사해서 .env 로 만들고 실제 값을 입력하세요
#  copy .env.example .env
# ==============================================================

# ── KIS 한국투자증권 OpenAPI ──────────────────────────────────
KIS_APP_KEY=your_app_key_here
KIS_APP_SECRET=your_app_secret_here
KIS_ACCOUNT_NO=your_account_number
KIS_ACCOUNT_TYPE=01
TRADING_MODE=paper
KIS_BASE_URL=https://openapivts.koreainvestment.com:29443

# ── 텔레그램 봇 ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# ── 데이터베이스 (MariaDB) ───────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=stock_trader
DB_USER=stock_trader
DB_PASSWORD=your_db_password

# ── 보안 설정 ─────────────────────────────────────────────────
MASTER_KEY=your_32byte_hex_master_key_here

# ── 리스크 관리 ──────────────────────────────────────────────
MAX_POSITION_RATIO=0.1
DAILY_LOSS_LIMIT=0.03
CIRCUIT_BREAKER_COUNT=3
DEFAULT_TRADE_AMOUNT=500000
MIN_SIGNAL_STRENGTH=3
APPROVAL_TIMEOUT=30
TIMEOUT_ACTION=cancel

# ── DART 공시 API (Phase 5, 선택) ────────────────────────────
DART_API_KEY=your_dart_api_key

# ── Local-AI (Phase 5, 선택) ─────────────────────────────────
LOCAL_AI_URL=http://localhost:1234/v1
LOCAL_AI_MODEL=gemma-2-9b-it
